# =============================================================
# NAS Capacity Pulse — Environment Variables
# =============================================================
# Copy this file to .env and update the values for production.
# These override the defaults in config.py and auth_manager.py.

# Session cookie signing key (CHANGE THIS in production)
SECRET_KEY=your-production-secret-key-here

# Default password for new user signups (if left blank on signup form)
DEFAULT_PASSWORD=welcome123

# Web server bind address and port
HOST=0.0.0.0
PORT=8080

# Path to server configuration YAML
CONFIG_PATH=server_config/servers.yaml

# SMTP settings for capacity threshold email alerts (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=nas-capacity-pulse@example.com
