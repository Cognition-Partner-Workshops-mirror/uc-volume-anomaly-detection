# Metrics Source
METRICS_ENDPOINT=http://prometheus:9090
METRICS_AUTH_TOKEN=changeme

# Detection Configuration
DETECTION_SENSITIVITY=5
BASELINE_WINDOW_DAYS=30
SEASONAL_THRESHOLD=2.5
ZSCORE_WARNING=2.0
ZSCORE_CRITICAL=3.0

# Alerting
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE
PAGERDUTY_ROUTING_KEY=changeme

# Dashboard
GRAFANA_URL=http://grafana:3000

# Logging
LOG_LEVEL=INFO
